# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Native crypto mirrors (native/ios/, native/android/) — kept out of ios/,
# android/ at the package root: Flutter's tooling (flutter test/pub get, since
# this package depends on plugins with native code) treats those exact names
# specially and injects its own GeneratedPluginRegistrant/ephemeral scaffolding
# into them, which collides with these being independent Swift/Gradle projects.

# Swift Package Manager (native/ios/)
native/ios/.build/
native/ios/.swiftpm/
native/ios/Package.resolved

# Gradle / Android (native/android/)
native/android/.gradle/
native/android/**/build/
native/android/**/.cxx/
native/android/local.properties
*.iml
